{
  "name": "orcamentos_sinapi",
  "version": "1.0.0",
  "description": "TLPlanly - Plataforma de orçamentação e auditoria de obras com referência SINAPI",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/src/server.js",
    "local": "npx ts-node src/index.ts",
    "server": "npx ts-node src/server.ts",
    "server:dev": "npx ts-node src/server.ts",
    "test": "npm run test:auditoria && npm run test:matching && npm run test:importadores && npm run test:saas && npm run test:custos",
    "test:auditoria": "npx ts-node tests/test_auditoria.ts",
    "test:matching": "npx ts-node tests/test_matching.ts",
    "test:importadores": "npx ts-node tests/test_importadores.ts",
    "test:saas": "npx ts-node tests/test_saas_store.ts",
    "test:custos": "npx ts-node tests/test_custos_horarios.ts",
    "test:real": "npx ts-node tests/est_arquivo_real.ts",
    "test:ai": "npx ts-node tests/test_ai.ts",
    "sinapi:info": "npx ts-node scripts/sinapi_info.ts",
    "sinapi:update": "npx ts-node scripts/sinapi_update.ts",
    "compile": "npx tsc --noEmit",
    "build": "npx tsc",
    "db:status": "npx ts-node scripts/saas_status.ts",
    "db:migrate": "npx ts-node scripts/saas_status.ts",
    "sinapi:import": "npx ts-node scripts/sinapi_import_xlsx.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  }
}
