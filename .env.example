# TLPlanly — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Anthropic API Key (obrigatório para o Copilot AI)
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXX

# DeepSeek API Key (opcional; fallback se a Anthropic ficar sem credito/limite)
# Obtenha em: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXX
DEEPSEEK_MODEL=deepseek-v4-flash

# Porta do servidor (opcional, padrão: 3000)
PORT=3000
