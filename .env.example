# TLPlanly — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Anthropic API Key (obrigatório para o Copilot AI)
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXX

# DeepSeek API Key (opcional; fallback se a Anthropic ficar sem credito/limite)
# Obtenha em: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXX
DEEPSEEK_MODEL=deepseek-v4-flash

# Banco SaaS (obrigatorio para producao persistente)
DATABASE_URL=postgres://usuario:senha@host:5432/tlplanly

# Segredo usado para assinar sessoes de login em producao
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta do servidor (opcional, padrão: 3000)
PORT=3000

# Cupons de cadastro autorizados.
# Formato: CODIGO:plano:max_usos:data_expiracao:trial_dias
# Planos: trial_authorized, professional, team, licitacoes_pro, public_control
# Exemplo: cupom de uso unico, expira em 2026-12-31 e libera 7 dias.
TLPLANLY_REGISTRATION_COUPONS=CLIENTE-ABC-2026:trial_authorized:1:2026-12-31:7
